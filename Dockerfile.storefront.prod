# syntax=docker.io/docker/dockerfile:1

FROM node:20-alpine AS base

# Set the working directory
WORKDIR /app

# Install dependencies only when needed
FROM base AS deps
# Check https://github.com/nodejs/docker-node/tree/b4117f9333da4138b03a546ec926ef50a31506c3#nodealpine to understand why libc6-compat might be needed.
RUN apk add --no-cache libc6-compat git

# Enable corepack and set yarn version
RUN corepack enable && corepack prepare yarn@3.2.3 --activate

# Clone the repository
RUN git clone https://github.com/medusajs/nextjs-starter-medusa.git /app

# Install dependencies based on the preferred package manager
RUN yarn install

# Set environment variable to disable telemetry
ENV NEXT_TELEMETRY_DISABLED=1

# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app

# Enable corepack and set yarn version in builder stage too
RUN corepack enable && corepack prepare yarn@3.2.3 --activate

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app ./

COPY ./.env ./.env
COPY ./storefront.next.config.js ./next.config.js

# Build with a temporary API key - will be replaced at runtime
ENV NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY="should_be_injected_into_this_container_for_build"
ENV MEDUSA_BACKEND_URL="http://localhost:9000"

RUN yarn build

# Production image, copy all the files and run next
FROM base AS runner
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

COPY ./replace-env-vars.sh /app/replace-env-vars.sh
RUN chmod +x /app/replace-env-vars.sh

USER nextjs

EXPOSE 8000

ENV PORT=8000
ENV NODE_ENV=production
ENV HOSTNAME="0.0.0.0"

ENTRYPOINT ["sh", "-c", "/app/replace-env-vars.sh && node server.js"]