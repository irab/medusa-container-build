# Database Configuration
DATABASE_TYPE=postgres
DATABASE_URL=postgres://postgres:postgres@postgres:5432/medusa-docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medusa-docker
PG_MEDUSA_DB_NAME="medusa"

# Redis Configuration
REDIS_URL=redis://redis:6379

# Medusa Configuration
MEDUSA_ADMIN_ONBOARDING_TYPE=default
STORE_CORS="https://your.store.domain.com" # most likely http://localhost:8000 for local dev
ADMIN_CORS=http://localhost:7000  ## ?? Probably not correct
JWT_SECRET=something
COOKIE_SECRET=something
NODE_ENV=development

# Medusa Backend URL (used by storefront)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Google Cloud
GCS_SA_PRIVATE_KEY="-----BEGIN PRIVATE....."
GCS_CLIENT_EMAIL="service_account_name@your_project_id.iam.gserviceaccount.com"
GCS_PUBLIC_BUCKET_NAME="bucket_name_here"

# Stripe Configuration
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY="sk_something"

# SendGrid
SENDGRID_API_KEY="SG.something"
SENDGRID_FROM="orders@example.com"
SENDGRID_ORDER_PLACED_ID="order_placed_template_id" # ID found in the SendGrid console https://mc.sendgrid.com/dynamic-templates

# Minio/S3 Configuration
S3_URL=http://minio:9000
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
MINIO_ENDPOINT="http://minio:10000"
MINIO_PRIVATE_BUCKET="medusa-exports"
MINIO_PRIVATE_ACCESS_KEY="SomeBigLongRandomStringHere"
MINIO_PRIVATE_SECRET_KEY="AnotherBigLongRandomStringHere"

# Admin User (used by bootstrap process)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=supersecret
